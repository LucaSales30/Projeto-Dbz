      "source": [
        "# Calcula a média das quatro notas\n",
        "media = (nota_1 + nota_2 + nota_3 + nota_4) / 4\n",
        "\n",
        "# Define a situação usando a estrutura if/elif/else\n",
        "if media >= 7.0:\n",
        "    situacao = \"Aprovado\"\n",
        "elif media >= 5.0:\n",
        "    situacao = \"Recuperação\"\n",
        "else:\n",
        "    situacao = \"Reprovado\"\n",
        "\n",
        "# Exibe o resultado\n",
        "print(f\"Média: {media:.2f}\")\n",
        "print(f\"Situação: {situacao}\")"
